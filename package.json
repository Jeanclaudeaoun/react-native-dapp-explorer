{
  "name": "react-native-dapp-explorer",
  "version": "0.1.0",
  "description": "Web3-enabled WebView component for React Native supporting EVM and Solana wallets",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!lib/**/__tests__"
  ],
  "scripts": {
    "build": "bob build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rm -rf lib",
    "version": "node scripts/version.js",
    "prepublishOnly": "yarn clean && yarn typecheck && yarn build"
  },
  "keywords": [
    "react-native",
    "web3",
    "ethereum",
    "solana",
    "dapp",
    "wallet",
    "webview",
    "metamask",
    "phantom",
    "wagmi",
    "ethers"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ethersproject/abstract-provider": "^5.7.0",
    "@solana/web3.js": "^1.87.6"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "react-native-builder-bob": "^0.20.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-webview": "^13.0.0",
    "expo": ">=49.0.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  }
}
